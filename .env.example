# APP_URL: The URL where this portfolio is hosted (e.g. GitHub Pages)
APP_URL="https://kixkixx2.github.io/portfolio_v3/"

# OpenRouter API Key for interactive terminal chatbot (optional)
# Can be configured here, in GitHub Secrets as VITE_OPENROUTER_API_KEY, or typed directly in the terminal as:
# set-key sk-or-v1-...
VITE_OPENROUTER_API_KEY=""

# Optional target model (default: meta-llama/llama-3.3-70b-instruct:free)
# Examples: google/gemini-2.0-flash-lite:free, openai/gpt-4o-mini, anthropic/claude-3.5-haiku
VITE_OPENROUTER_MODEL=""
